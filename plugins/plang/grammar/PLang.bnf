// Copyright 2026 pLang IDE contributors. Use of this source code is governed by the Apache 2.0 license.
// Grammar for the pLang language (https://github.com/PleaseEnterYourText-Studio/pLang).
// Mirrors the reference compiler grammar (docs.md). Regenerate the parser with Grammar-Kit.
{
  parserClass="org.plang.lang.parser.PLangParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"
  psiClassPrefix="PLang"
  psiImplClassSuffix="Impl"
  psiPackage="org.plang.lang.psi"
  psiImplPackage="org.plang.lang.psi.impl"

  elementTypeHolderClass="org.plang.lang.psi.PLangTypes"
  elementTypeClass="org.plang.lang.psi.PLangElementType"
  tokenTypeClass="org.plang.lang.psi.PLangTokenTypes"

  tokens = [
    WHITE_SPACE="Whitespace"
    LINE_COMMENT="line comment"
    BLOCK_COMMENT="block comment"
    IDENTIFIER="identifier"
    NUMBER="number"
    STRING="string"
    CHAR_LIT="char"
  ]
}

plangFile ::= package_decl? import_decl* top_level_decl*

package_decl ::= PACKAGE qualified_name SEMICOLON
import_decl  ::= IMPORT qualified_name SEMICOLON

qualified_name ::= IDENTIFIER (DOT IDENTIFIER)*

top_level_decl ::= using_decl
                 | type_decl
                 | impl_decl
                 | func_decl
                 | extern_decl
                 | var_decl
                 | statement

using_decl ::= USING IDENTIFIER ASSIGN type_expr SEMICOLON

type_decl ::= (ABSTRACT | STRUCT | UNION | ENUM | ALIGN) inheritance? type_body
type_body ::= LBRACE member* RBRACE
inheritance ::= COLON visibility? qualified_name

impl_decl ::= IMPL qualified_name (FOR qualified_name)? LBRACE member* RBRACE

func_decl ::= FUNC IDENTIFIER param_list (COLON type_expr | ARROW type_expr)? block?
extern_decl ::= EXTERN FUNC IDENTIFIER param_list (COLON type_expr)? SEMICOLON

param_list ::= LPAREN param? (COMMA param)* RPAREN
param ::= (VAR | VAL | MOVED | VOLATILE | ARROW VAR) COLON type_expr IDENTIFIER

var_decl ::= (VAR | VAL) (COLON type_expr)? IDENTIFIER (ASSIGN expr)? SEMICOLON

block ::= LBRACE statement* RBRACE

statement ::= if_stmt
            | while_stmt
            | for_stmt
            | switch_stmt
            | return_stmt
            | goto_stmt
            | label_stmt
            | asm_stmt
            | expr_stmt
            | block
            | var_decl

if_stmt ::= IF paren_expr block (ELSE (if_stmt | block))?
while_stmt ::= WHILE paren_expr block
for_stmt ::= FOR LPAREN statement expr SEMICOLON expr RPAREN block
switch_stmt ::= SWITCH paren_expr LBRACE (CASE expr COLON block)* (DEFAULT COLON block)? RBRACE
return_stmt ::= RETURN expr? SEMICOLON
goto_stmt ::= GOTO IDENTIFIER SEMICOLON
label_stmt ::= LABEL IDENTIFIER COLON
asm_stmt ::= ASM block
expr_stmt ::= expr SEMICOLON

paren_expr ::= LPAREN expr RPAREN

expr ::= lambda_expr
       | unary_expr (binary_op unary_expr)*

lambda_expr ::= LAMBDA param_list (COLON type_expr)? block

unary_expr ::= unary_op* postfix_expr
postfix_expr ::= primary (LPAREN expr_list? RPAREN | LBRACKET expr RBRACKET | DOT IDENTIFIER | INC | DEC | ARROW IDENTIFIER)*
primary ::= literal
          | IDENTIFIER
          | SIZEOF LPAREN type_expr RPAREN
          | type_expr AS expr
          | LBRACE expr_list? RBRACE
          | paren_expr

expr_list ::= expr (COMMA expr)*

literal ::= NUMBER | STRING | CHAR_LIT | TRUE | FALSE | NULL_LIT

type_expr ::= (ARROW VAR)? (COLON)? qualified_name generic_args? (LBRACKET expr? RBRACKET)?
generic_args ::= LT type_expr (COMMA type_expr)* GT

visibility ::= PUB | PRT | PRI
member ::= (visibility)? (var_decl | func_decl | type_decl | using_decl)

unary_op ::= PLUS | MINUS | NOT | TILDE | STAR | AMP | INC | DEC
binary_op ::= PLUS | MINUS | STAR | SLASH | PERCENT
            | EQ | NE | LT | LE | GT | GE
            | AND | OR | AMP | PIPE | CARET | SHL | SHR
            | ASSIGN | PLUS_ASSIGN | MINUS_ASSIGN | STAR_ASSIGN | SLASH_ASSIGN | PERCENT_ASSIGN
            | SHL_ASSIGN | SHR_ASSIGN | AMP_ASSIGN | PIPE_ASSIGN | CARET_ASSIGN
            | QUESTION
